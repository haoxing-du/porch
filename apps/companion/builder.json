{
  "appId": "com.porch.companion",
  "productName": "Porch Companion",
  "directories": { "app": "apps/companion", "output": "release" },
  "files": ["dist/**/*", "package.json"],
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": [
      { "target": "dmg", "arch": ["arm64"] },
      { "target": "zip", "arch": ["arm64"] }
    ],
    "hardenedRuntime": true,
    "entitlements": "apps/companion/entitlements.mac.plist",
    "entitlementsInherit": "apps/companion/entitlements.mac.plist",
    "extendInfo": { "LSUIElement": true }
  },
  "dmg": { "title": "Porch Companion" }
}
