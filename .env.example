DATABASE_URL=postgres://localhost/porch
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
DEV_AUTH=true
UPLOAD_DIR=.local/uploads
# Required for pilot deployment; DEV_AUTH must be false and NODE_ENV=production.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional S3-compatible storage; omit to use UPLOAD_DIR on a persistent volume.
S3_BUCKET=
S3_ENDPOINT=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Use a signed/notarized artifact for public distribution.
# Defaults locally to release/Porch Companion-0.1.0-arm64.dmg when it exists.
COMPANION_DOWNLOAD_PATH=
COMPANION_DOWNLOAD_URL=
