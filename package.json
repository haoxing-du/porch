{
  "name": "porch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k 'tsx watch apps/server/src/main.ts' 'vite --host 127.0.0.1'",
    "start": "tsx apps/server/src/main.ts",
    "migrate": "tsx apps/server/src/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test:e2e": "playwright test",
    "companion:build": "node scripts/build-companion.mjs",
    "companion": "npm run companion:build && electron apps/companion",
    "companion:package": "npm run companion:build && electron-builder --config apps/companion/builder.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1132.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "9.4.0",
    "@fastify/oauth2": "8.3.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "11.3.0",
    "dotenv": "17.4.2",
    "fastify": "5.12.4",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "ws": "8.21.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "concurrently": "9.2.4",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
